{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itainover-create.github.io/fw-mem-guard/schema/v1.json",
  "title": "FW Mem Guard compare CLI JSON v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "pass",
        "budget_exceeded"
      ]
    },
    "validation": {
      "const": "configured_linker_profile"
    },
    "attribution": {
      "enum": [
        "gnu_input_sections",
        "not_available"
      ]
    },
    "baseline": {
      "$ref": "#/$defs/usage"
    },
    "current": {
      "$ref": "#/$defs/usage"
    },
    "delta": {
      "$ref": "#/$defs/pair"
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "budgetChecks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "attributionCoverage": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "flash": {
              "$ref": "#/$defs/coverage"
            },
            "ram": {
              "$ref": "#/$defs/coverage"
            }
          },
          "required": [
            "flash",
            "ram"
          ],
          "additionalProperties": true
        }
      ]
    },
    "section_delta": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "banks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "memory": {
            "enum": [
              "flash",
              "ram"
            ]
          },
          "capacity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "baseline": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "current": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "delta": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "memory",
          "capacity",
          "baseline",
          "current",
          "delta"
        ],
        "additionalProperties": true
      }
    },
    "contributors": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contributor"
          }
        },
        "archives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contributor"
          }
        },
        "unattributed": {
          "type": "object",
          "properties": {
            "baseline": {
              "$ref": "#/$defs/usage"
            },
            "current": {
              "$ref": "#/$defs/usage"
            },
            "delta": {
              "$ref": "#/$defs/pair"
            }
          },
          "required": [
            "baseline",
            "current",
            "delta"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "objects",
        "archives",
        "unattributed"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "schema_version",
    "status",
    "validation",
    "attribution",
    "baseline",
    "current",
    "delta",
    "violations",
    "budgetChecks",
    "attributionCoverage"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "violations": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "violations": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "pair": {
      "type": "object",
      "properties": {
        "flash": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ram": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "flash",
        "ram"
      ],
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "properties": {
        "flash": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ram": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "flash",
        "ram"
      ],
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "properties": {
        "memory": {
          "enum": [
            "flash",
            "ram"
          ]
        },
        "metric": {
          "enum": [
            "usage_bytes",
            "growth_bytes"
          ]
        },
        "actual": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "region": {
          "type": "string"
        },
        "exceeded": {
          "type": "boolean"
        }
      },
      "required": [
        "memory",
        "metric",
        "actual",
        "limit"
      ],
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "baselineUnattributedPercent": {
          "type": [
            "number",
            "null"
          ]
        },
        "currentUnattributedPercent": {
          "type": [
            "number",
            "null"
          ]
        },
        "unattributedNetGrowthPercent": {
          "type": [
            "number",
            "null"
          ]
        },
        "unattributedPositiveGrowthPercent": {
          "type": [
            "number",
            "null"
          ]
        },
        "netGrowthBytes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "unattributedDeltaBytes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "positiveGrowthBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "positiveUnattributedGrowthBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "baselineUnattributedPercent",
        "currentUnattributedPercent",
        "unattributedNetGrowthPercent",
        "unattributedPositiveGrowthPercent",
        "netGrowthBytes",
        "unattributedDeltaBytes",
        "positiveGrowthBytes",
        "positiveUnattributedGrowthBytes"
      ],
      "additionalProperties": true
    },
    "contributor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/usage"
        },
        "current": {
          "$ref": "#/$defs/usage"
        },
        "delta": {
          "$ref": "#/$defs/pair"
        }
      },
      "required": [
        "name",
        "baseline",
        "current",
        "delta"
      ],
      "additionalProperties": true
    }
  }
}
