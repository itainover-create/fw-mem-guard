+// FW Mem Guard test change: +4096 bytes RAM (.bss), +8192 bytes Flash (.rodata)
+static volatile uint8_t fwmg_test_ram[4096];
+static const uint8_t fwmg_test_table[8192] = { [0] = 1, [4095] = 3, [8191] = 2 };
+static void __attribute__((noinline)) fwmg_test_touch(void) {
+    uint32_t s = 0;
+    for (size_t i = 0; i < sizeof(fwmg_test_table); i += 512) {
+        s += fwmg_test_table[(i + fwmg_test_ram[1]) & (sizeof(fwmg_test_table) - 1)];
+    }
+    fwmg_test_ram[0] = (uint8_t)s;
+}
